# Copy to .env (git-ignored). Choose your own password; do not reuse a real one.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-to-a-long-random-string
JENKINS_HOST_PORT=8085

# Read the code from GitHub...
JENKINS_REPO_URL=https://github.com/dineshravichandiran/devsecops-ci-pipeline.git
JENKINS_REPO_BRANCH=*/feat/platform-addons
# ...or from a local checkout: set JENKINS_REPO_URL=file:///repo and JENKINS_LOCAL_REPO=/absolute/path/to/this/repo
JENKINS_LOCAL_REPO=
# Needed ONLY for the local-repo mode above (Jenkins blocks local-folder checkouts by default):
JENKINS_ALLOW_LOCAL_CHECKOUT=false

# Optional. Request a free key from the NVD (nvd.nist.gov/developers/request-an-api-key); never commit it.
# Without it the SCA stage is marked UNSTABLE and produces no report.
NVD_API_KEY=
